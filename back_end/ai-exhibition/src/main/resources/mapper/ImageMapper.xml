<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.zyy.mapper.ImageMapper">

    <!-- 批量插入上传图片记录 -->
    <insert id="insertBatch" parameterType="java.util.List" useGeneratedKeys="true" keyProperty="imageId">
        insert into uploaded_image(user_id, image_type, image_url, upload_time)
        values
        <foreach collection="list" item="item" separator=",">
            (#{item.userId}, #{item.imageType}, #{item.imageUrl}, #{item.uploadTime})
        </foreach>
    </insert>

</mapper>
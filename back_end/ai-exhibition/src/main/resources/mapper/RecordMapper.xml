<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zyy.mapper.RecordMapper">

    <!-- 动态更新展览记录 -->
    <update id="update" parameterType="com.zyy.entity.ExhibitionRecord">
        UPDATE exhibition_record
        <set>
            <if test="title != null and title != ''">
                title = #{title},
            </if>
            <if test="galleryName != null and galleryName != ''">
                gallery_name = #{galleryName},
            </if>
            <if test="exhibitionDate != null">
                exhibition_date = #{exhibitionDate},
            </if>
            <if test="country != null and country != ''">
                country = #{country},
            </if>
            <if test="city != null and city != ''">
                city = #{city},
            </if>
            <if test="artist != null and artist != ''">
                artist = #{artist},
            </if>
            <if test="styleTags != null and styleTags != ''">
                style_tags = #{styleTags},
            </if>
            <if test="notes != null and notes != ''">
                notes = #{notes},
            </if>
            <if test="aiSummary != null and aiSummary != ''">
                ai_summary = #{aiSummary},
            </if>
            <if test="coverImageUrl != null and coverImageUrl != ''">
                cover_image_url = #{coverImageUrl},
            </if>
            <if test="updateTime != null">
                update_time = #{updateTime},
            </if>
        </set>
        WHERE record_id = #{recordId} AND user_id = #{userId}
    </update>

</mapper>
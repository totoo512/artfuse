/* 水平间距 */
/* 水平间距 */
.ai-explore-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
}
.header {
  height: 50px;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #ffffff;
  border-bottom: 1px solid #eeeeee;
}
.header .title {
  font-size: 18px;
  font-weight: bold;
  color: #000000;
}
.chat-container {
  flex: 1;
  padding: 40px;
  overflow-y: auto;
}
.message-list {
  width: 100%;
}
.message {
  display: flex;
  margin-bottom: 12px;
  align-items: flex-start;
}
.message .avatar {
  width: 32px;
  height: 32px;
  flex: 0 0 32px;
  min-width: 32px;
  min-height: 32px;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 8px;
}
.message .avatar image {
  width: 100%;
  height: 100%;
}
.message .message-content {
  padding: 8px 12px;
  border-radius: 14px;
  word-break: break-all;
  line-height: 1.45;
  max-width: 75%;
}
.message .message-content text {
  font-size: 13px;
}
.message .message-content .message-image {
  max-width: 200px;
  max-height: 200px;
  border-radius: 8px;
  cursor: pointer;
}
.ai-message {
  align-self: flex-start;
}
.ai-message .message-content {
  background-color: #ffffff;
  color: #000000;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
}
.user-message {
  flex-direction: row-reverse;
  align-self: flex-end;
}
.user-message .avatar {
  margin-right: 0;
  margin-left: 8px;
}
.user-message .message-content {
  background-color: #4a6cf7;
  color: #ffffff;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
}
.input-container {
  display: flex;
  padding: 8px;
  background-color: #ffffff;
  border-top: 1px solid #eeeeee;
}
.input-container .input-wrapper {
  display: flex;
  align-items: center;
  flex: 1;
  height: 36px;
  padding: 0 12px;
  background-color: #f5f5f5;
  border-radius: 18px;
  margin-right: 8px;
}
.input-container .input {
  flex: 1;
  height: 36px;
  padding: 0;
  background: none;
  border: none;
  border-radius: 0;
  font-size: 13px;
}
.input-container .camera-btn {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: #e0e0e0;
  margin-left: 8px;
  transition: background-color 0.2s;
}
.input-container .camera-btn:active {
  background-color: #d0d0d0;
}
.input-container .send-btn {
  width: 72px;
  height: 36px;
  margin-left: 8px;
  background-color: #4a6cf7;
  color: #ffffff;
  border-radius: 18px;
  font-size: 13px;
  display: flex;
  align-items: center;
  justify-content: center;
}
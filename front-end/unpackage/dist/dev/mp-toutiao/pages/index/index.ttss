/* 水平间距 */
/* 水平间距 */
.page-container {
  padding: 0;
  margin: 0;
  background-color: #ffffff;
}
.brand-header {
  display: flex;
  align-items: center;
  padding: 10px 15px;
  background-color: #ffffff;
  border-bottom: 1px solid #eeeeee;
}
.brand-header .logo {
  width: 30px;
  height: 30px;
  margin-right: 10px;
  border-radius: 50%;
}
.brand-header .brand-name {
  flex: 1;
  font-size: 16px;
  font-weight: bold;
}
.brand-header .header-buttons {
  display: flex;
  align-items: center;
}
.brand-header .feedback-btn,
.brand-header .more-btn,
.brand-header .close-btn {
  background: none;
  border: none;
  padding: 5px 10px;
  font-size: 14px;
}
.main-banner {
  position: relative;
  width: 100%;
  height: 300px;
  overflow: hidden;
}
.main-banner .banner-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.main-banner .banner-text {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 20px;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.7), transparent);
  color: #ffffff;
}
.main-banner .banner-text .banner-title {
  font-size: 18px;
  font-weight: bold;
  display: block;
  margin-bottom: 5px;
}
.main-banner .banner-text .banner-subtitle {
  font-size: 14px;
  display: block;
  margin-bottom: 15px;
}
.main-banner .banner-text .ai-explore-btn {
  position: absolute;
  bottom: 70px;
  right: 50px;
  background-color: #4a6cf7;
  color: #ffffff;
  width: 80px;
  height: 80px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 12px rgba(74, 108, 247, 0.4);
  z-index: 10;
}
.main-banner .banner-text .ai-btn-text {
  font-size: 14px;
  font-weight: bold;
  text-align: center;
  line-height: 1.3;
}
.main-banner .banner-text .try-btn-container {
  position: absolute;
  bottom: 20px;
  right: 50px;
  display: flex;
  align-items: center;
}
.main-banner .banner-text .try-btn-text {
  color: #ffffff;
  font-size: 14px;
  margin-right: 10px;
}
.main-banner .banner-text .try-btn-icon {
  background-color: #dfd7c9;
  color: #949494;
  border: none;
  width: 30px;
  height: 30px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  box-shadow: 0 2px 8px rgba(96, 96, 96, 0.4);
  /* 灰色阴影 */
  cursor: pointer;
  transition: background-color 0.2s;
}
.main-banner .banner-text .try-btn-icon:active {
  background-color: #c8c0b2;
}
.main-banner .banner-text .arrow-right {
  font-size: 24px;
  font-weight: bold;
  color: #000000;
}
.assets-section {
  padding: 15px;
}
.assets-section .section-title {
  font-size: 18px;
  font-weight: bold;
  margin-bottom: 15px;
}
.assets-section .tab-bar {
  display: flex;
  width: 50%;
  margin-bottom: 15px;
  justify-content: space-between;
}
.assets-section .tab-bar .tab-btn {
  width: 48%;
  background: none;
  padding: 4px 0;
  font-size: 14px;
  color: #999999;
  position: relative;
}
.assets-section .tab-bar .tab-btn.active {
  color: #000000;
  font-weight: bold;
}
.assets-section .tab-bar .tab-btn.active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 25px;
  height: 3px;
  background-color: #ff0050;
}
.assets-section .masonry-container {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 10px;
}
.assets-section .masonry-container .loading-container {
  width: 100%;
  height: 200px;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
  border-radius: 8px;
}
.assets-section .masonry-container .loading-text {
  color: #666666;
  font-size: 14px;
}
.assets-section .masonry-container .empty-container {
  width: 100%;
  height: 200px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
  border-radius: 8px;
}
.assets-section .masonry-container .empty-text {
  color: #666666;
  font-size: 16px;
  margin-bottom: 8px;
}
.assets-section .masonry-container .empty-hint {
  color: #999999;
  font-size: 12px;
}
.assets-section .masonry-container .masonry-item {
  width: calc(50% - 5px);
  /* 减去一半的gap宽度 */
  border-radius: 8px;
  overflow: hidden;
  background-color: #f5f5f5;
  margin-bottom: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  aspect-ratio: 1/1;
  /* 保持正方形比例 */
}
.assets-section .masonry-container .masonry-item .video-placeholder {
  width: 100%;
  height: 100%;
  background-color: #e0e0e0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.assets-section .masonry-container .masonry-item .video-text {
  color: #666666;
  font-size: 14px;
}
.assets-section .masonry-container .masonry-item image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
<view class="page-container"><view class="main-banner"><image class="banner-image" src="{{a}}"></image><view class="banner-text"><text class="banner-title">穆夏——新艺术运动时期</text><text class="banner-subtitle">于20世纪第18世纪</text><view class="ai-explore-btn" bindtap="{{b}}"><text class="ai-btn-text">AI看展</text></view><view class="try-btn-container"><text class="try-btn-text">立即试试</text><view class="try-btn-icon" bindtap="{{d}}"><uni-icons tt:if="{{c}}" u-i="23550c81-0" bind:__l="__l" u-p="{{c}}"></uni-icons></view></view></view></view><view class="assets-section"><view class="section-title">我的创作</view><view class="tab-bar"><button class="{{('tab-btn') + ' ' + (e && 'active')}}" bindtap="{{f}}">图片</button><button class="{{('tab-btn') + ' ' + (g && 'active')}}" bindtap="{{h}}">视频</button></view><view class="masonry-container"><view tt:if="{{i}}" class="loading-container"><text class="loading-text">加载中...</text></view><view tt:elif="{{j}}" class="empty-container"><text class="empty-text">暂无{{k}}创作</text><text class="empty-hint">快去创作一些精彩内容吧！</text></view><block tt:else><view tt:for="{{l}}" tt:for-item="item" tt:key="c" class="masonry-item"><block tt:if="{{m}}"><image src="{{item.a}}" mode="aspectFill"></image></block><block tt:else><view class="video-placeholder"><text class="video-text">{{item.b}}</text></view></block></view></block></view></view></view>
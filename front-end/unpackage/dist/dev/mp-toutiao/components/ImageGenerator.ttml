<view class="image-generator-container"><view class="generator-card"><text class="title">AI图像生成</text><view class="form-group"><text class="label">上传个人图像</text><view class="upload-area" bindtap="{{c}}"><image tt:if="{{a}}" src="{{b}}" class="preview-image" mode="aspectFit"></image><view tt:else class="upload-placeholder"><text class="upload-text">点击上传个人图像</text></view></view></view><view class="form-group"><text class="label">上传展览图像</text><view class="upload-area" bindtap="{{f}}"><image tt:if="{{d}}" src="{{e}}" class="preview-image" mode="aspectFit"></image><view tt:else class="upload-placeholder"><text class="upload-text">点击上传展览图像</text></view></view></view><view class="form-group"><text class="label">图像尺寸</text><picker class="picker" bindchange="{{h}}" range="{{i}}"><view class="picker-text">{{g}}</view></picker></view><view class="form-group"><text class="label">引导比例 (1-10)</text><slider class="slider" min="{{1}}" max="{{10}}" value="{{j}}" bindchange="{{k}}"/><text class="slider-value">{{l}}</text></view><button class="generate-btn" loading="{{n}}" bindtap="{{o}}">{{m}}</button><view tt:if="{{p}}" class="result-container"><text class="result-title">生成结果</text><view class="result-images-container"><view tt:for="{{q}}" tt:for-item="imageUrl" tt:key="d" class="result-image-item"><image class="result-image" src="{{imageUrl.a}}" mode="aspectFit"></image><button class="save-btn" bindtap="{{imageUrl.c}}">保存图片 {{imageUrl.b}}</button></view></view></view><view tt:if="{{r}}" class="error-message">{{s}}</view></view></view>
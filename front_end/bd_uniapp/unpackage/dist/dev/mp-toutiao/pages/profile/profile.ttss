
.profile-container.data-v-dd383ca2 {
	background-color: #f5f5f5;
	min-height: 100vh;
}

/* 用户信息头部 */
.user-header.data-v-dd383ca2 {
	display: flex;
	align-items: center;
	padding: 20px;
	background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
	color: white;
	position: relative;
}
.user-avatar.data-v-dd383ca2 {
	position: relative;
	margin-right: 15px;
}
.avatar-img.data-v-dd383ca2 {
	width: 70px;
	height: 70px;
	border-radius: 35px;
	border: 3px solid rgba(255, 255, 255, 0.3);
}
.vip-badge.data-v-dd383ca2 {
	position: absolute;
	top: -5px;
	right: -5px;
}
.user-info.data-v-dd383ca2 {
	flex: 1;
}
.user-name.data-v-dd383ca2 {
	font-size: 20px;
	font-weight: bold;
	display: block;
	margin-bottom: 5px;
}
.user-phone.data-v-dd383ca2 {
	font-size: 14px;
	opacity: 0.8;
	display: block;
	margin-bottom: 10px;
}
.user-stats.data-v-dd383ca2 {
	display: flex;
	gap: 20px;
}
.stat-item.data-v-dd383ca2 {
	display: flex;
	flex-direction: column;
	align-items: center;
}
.stat-number.data-v-dd383ca2 {
	font-size: 16px;
	font-weight: bold;
}
.stat-label.data-v-dd383ca2 {
	font-size: 12px;
	opacity: 0.8;
}
.user-actions.data-v-dd383ca2 {
	margin-left: 10px;
}
.edit-btn.data-v-dd383ca2 {
	width: 40px;
	height: 40px;
	border-radius: 20px;
	background: rgba(255, 255, 255, 0.2);
	border: none;
	display: flex;
	align-items: center;
	justify-content: center;
}

/* 通用section样式 */
.section.data-v-dd383ca2 {
	margin: 15px 0;
	background: white;
	border-radius: 10px;
	overflow: hidden;
}

/* 积分卡片 */
.points-card.data-v-dd383ca2 {
	margin: 10px;
}
.points-header.data-v-dd383ca2 {
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 15px;
}
.points-info.data-v-dd383ca2 {
	display: flex;
	flex-direction: column;
}
.points-title.data-v-dd383ca2 {
	font-size: 14px;
	color: #666;
	margin-bottom: 5px;
}
.points-value.data-v-dd383ca2 {
	font-size: 24px;
	font-weight: bold;
	color: #007AFF;
}
.sign-btn.data-v-dd383ca2 {
	padding: 8px 16px;
	background: #007AFF;
	color: white;
	border: none;
	border-radius: 20px;
	font-size: 14px;
}
.sign-btn.data-v-dd383ca2:disabled {
	background: #ccc;
}
.points-actions.data-v-dd383ca2 {
	display: flex;
	justify-content: space-around;
	padding-top: 15px;
	border-top: 1px solid #f0f0f0;
}
.action-item.data-v-dd383ca2 {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 5px;
	cursor: pointer;
}
.action-text.data-v-dd383ca2 {
	font-size: 12px;
	color: #007AFF;
}

/* VIP卡片 */
.vip-card.data-v-dd383ca2 {
	margin: 10px;
	position: relative;
}
.vip-card.vip-active.data-v-dd383ca2 {
	background: linear-gradient(135deg, #FF6B35 0%, #F7931E 100%);
	color: white;
}
.vip-header.data-v-dd383ca2 {
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 15px;
}
.vip-title.data-v-dd383ca2 {
	font-size: 18px;
	font-weight: bold;
	margin-bottom: 5px;
	display: block;
}
.vip-desc.data-v-dd383ca2 {
	font-size: 14px;
	opacity: 0.8;
}
.vip-benefits.data-v-dd383ca2 {
	display: flex;
	flex-direction: column;
	gap: 10px;
	margin-bottom: 20px;
}
.benefit-item.data-v-dd383ca2 {
	display: flex;
	align-items: center;
	gap: 8px;
}
.benefit-text.data-v-dd383ca2 {
	font-size: 14px;
	color: #666;
}
.benefit-text.active.data-v-dd383ca2 {
	color: white;
}
.vip-btn.data-v-dd383ca2 {
	width: 100%;
	padding: 12px;
	background: #007AFF;
	color: white;
	border: none;
	border-radius: 8px;
	font-size: 16px;
	font-weight: bold;
}
.vip-btn.renew.data-v-dd383ca2 {
	background: rgba(255, 255, 255, 0.2);
	color: white;
	border: 1px solid rgba(255, 255, 255, 0.3);
}

  margin-right: 20rpx;
}
.copy-btn.data-v-4ffa4d58 {
  padding: 10rpx 20rpx;
  background-color: #f8f8f8;
  border: 1rpx solid #ddd;
  border-radius: 6rpx;
  font-size: 24rpx;
  color: #333;
}


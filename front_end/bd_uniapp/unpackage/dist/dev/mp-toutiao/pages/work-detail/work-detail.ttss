
.work-detail-container.data-v-0671e18f {
	background-color: #000;
	min-height: 100vh;
}
.nav-actions.data-v-0671e18f {
	display: flex;
	align-items: center;
	gap: 10px;
}
.action-btn.data-v-0671e18f {
	width: 36px;
	height: 36px;
	border-radius: 18px;
	background: rgba(255, 255, 255, 0.2);
	border: none;
	display: flex;
	align-items: center;
	justify-content: center;
}
.work-display.data-v-0671e18f {
	position: relative;
	height: 60vh;
	background: #000;
}
.work-swiper.data-v-0671e18f {
	width: 100%;
	height: 100%;
}
.work-image.data-v-0671e18f {
	width: 100%;
	height: 100%;
}
.work-image.single.data-v-0671e18f {
	height: 60vh;
}
.work-video.data-v-0671e18f {
	width: 100%;
	height: 100%;
}
.work-info.data-v-0671e18f {
	background: white;
	padding: 20px 15px;
	border-radius: 20px 20px 0 0;
	margin-top: -20px;
	position: relative;
	z-index: 10;
}
.info-header.data-v-0671e18f {
	display: flex;
	justify-content: space-between;
	align-items: flex-start;
	margin-bottom: 15px;
}
.work-title.data-v-0671e18f {
	font-size: 20px;
	font-weight: bold;
	color: #333;
	flex: 1;
	margin-right: 15px;
}
.work-stats.data-v-0671e18f {
	display: flex;
	gap: 15px;
}
.stat-item.data-v-0671e18f {
	display: flex;
	align-items: center;
	gap: 5px;
}
.stat-text.data-v-0671e18f {
	font-size: 14px;
	color: #666;
}
.work-meta.data-v-0671e18f {
	display: flex;
	flex-direction: column;
	gap: 10px;
	margin-bottom: 20px;
}
.meta-item.data-v-0671e18f {
	display: flex;
	justify-content: space-between;
	align-items: center;
}
.meta-label.data-v-0671e18f {
	font-size: 14px;
	color: #666;
}
.meta-value.data-v-0671e18f {
	font-size: 14px;
	color: #333;
	font-weight: 500;
}
.style-tag.data-v-0671e18f {
	background: #e3f2fd;
	color: #007AFF;
	padding: 4px 8px;
	border-radius: 12px;
	font-size: 12px;
}
.work-description.data-v-0671e18f {
	padding-top: 15px;
	border-top: 1px solid #f0f0f0;
}
.desc-title.data-v-0671e18f {
	font-size: 16px;
	font-weight: 500;
	color: #333;
	display: block;
	margin-bottom: 8px;
}
.desc-content.data-v-0671e18f {
	font-size: 14px;
	color: #666;
	line-height: 1.6;
	display: block;
}
.generation-params.data-v-0671e18f,
.source-materials.data-v-0671e18f {
	background: white;
	margin: 0 15px 15px;
	border-radius: 12px;
	overflow: hidden;
}
.params-list.data-v-0671e18f {
	padding: 15px;
}
.param-item.data-v-0671e18f {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 10px 0;
	border-bottom: 1px solid #f5f5f5;
}
.param-item.data-v-0671e18f:last-child {
	border-bottom: none;
}
.param-label.data-v-0671e18f {
	font-size: 14px;
	color: #666;
}
.param-value.data-v-0671e18f {
	font-size: 14px;
	color: #333;
	font-family: monospace;
	max-width: 60%;
	text-align: right;
	word-break: break-all;
}
.source-grid.data-v-0671e18f {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 10px;
	padding: 15px;
}
.source-item.data-v-0671e18f {
	text-align: center;
}
.source-image.data-v-0671e18f {
	width: 100%;
	aspect-ratio: 1;
	border-radius: 8px;
	margin-bottom: 5px;
}
.source-label.data-v-0671e18f {
	font-size: 12px;
	color: #666;
	display: block;
}
.action-buttons.data-v-0671e18f {
	display: flex;
	gap: 10px;
	padding: 20px 15px;
	background: white;
}
.action-button.data-v-0671e18f {
	flex: 1;
	display: flex;
	align-items: center;
	justify-content: center;
	gap: 5px;
	padding: 12px;
	border-radius: 8px;
	border: none;
	font-size: 14px;
}
.action-button.primary.data-v-0671e18f {
	background: #007AFF;
	color: white;
}
.action-button.secondary.data-v-0671e18f {
	background: #f8f9fa;
	color: #007AFF;
	border: 1px solid #007AFF;
}
.button-text.data-v-0671e18f {
	color: inherit;
}

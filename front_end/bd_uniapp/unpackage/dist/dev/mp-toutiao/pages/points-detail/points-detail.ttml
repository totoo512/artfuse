<view class="points-detail-container data-v-c7790286"><uni-nav-bar tt:if="{{b}}" class="data-v-c7790286" bindclickLeft="{{a}}" u-i="c7790286-0" bind:__l="__l" u-p="{{b}}"></uni-nav-bar><view class="points-overview data-v-c7790286"><view class="overview-card data-v-c7790286"><view class="points-info data-v-c7790286"><text class="current-points data-v-c7790286">{{c}}</text><text class="points-label data-v-c7790286">当前积分</text></view><view class="points-stats data-v-c7790286"><view class="stat-item data-v-c7790286"><text class="stat-value data-v-c7790286">+{{d}}</text><text class="stat-label data-v-c7790286">累计获得</text></view><view class="stat-item data-v-c7790286"><text class="stat-value data-v-c7790286">-{{e}}</text><text class="stat-label data-v-c7790286">累计消费</text></view></view></view></view><view class="filter-tabs data-v-c7790286"><view tt:for="{{f}}" tt:for-item="tab" tt:key="b" class="{{('tab-item') + ' ' + 'data-v-c7790286' + ' ' + (tab.c && 'active')}}" bindtap="{{tab.d}}"><text class="tab-text data-v-c7790286">{{tab.a}}</text></view></view><view class="records-list data-v-c7790286"><view tt:for="{{g}}" tt:for-item="record" tt:key="l" class="record-item data-v-c7790286"><view class="record-icon data-v-c7790286"><uni-icons tt:if="{{record.b}}" class="data-v-c7790286" u-i="{{record.a}}" bind:__l="__l" u-p="{{record.b}}"></uni-icons></view><view class="record-content data-v-c7790286"><view class="record-header data-v-c7790286"><text class="record-title data-v-c7790286">{{record.c}}</text><text class="{{('record-amount') + ' ' + 'data-v-c7790286' + ' ' + (record.f && 'positive') + ' ' + (record.g && 'negative')}}">{{record.d}}{{record.e}}</text></view><view class="record-meta data-v-c7790286"><text class="record-desc data-v-c7790286">{{record.h}}</text><text class="record-time data-v-c7790286">{{record.i}}</text></view><view tt:if="{{record.j}}" class="record-order data-v-c7790286"><text class="order-label data-v-c7790286">订单号：</text><text class="order-id data-v-c7790286">{{record.k}}</text></view></view></view></view><view tt:if="{{h}}" class="empty-state data-v-c7790286"><uni-icons tt:if="{{i}}" class="data-v-c7790286" u-i="c7790286-2" bind:__l="__l" u-p="{{i}}"></uni-icons><text class="empty-text data-v-c7790286">暂无积分记录</text><text class="empty-desc data-v-c7790286">完成任务即可获得积分奖励</text></view><view tt:if="{{j}}" class="load-more data-v-c7790286"><button class="load-more-btn data-v-c7790286" bindtap="{{l}}" loading="{{m}}">{{k}}</button></view></view>
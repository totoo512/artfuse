}
.original-price.data-v-94171f33 {
	font-size: 14px;
	color: #999;
	text-decoration: line-through;
}
.plan-features.data-v-94171f33 {
	display: flex;
	flex-direction: column;
	gap: 8px;
}
.feature-item.data-v-94171f33 {
	display: flex;
	align-items: center;
	gap: 8px;
}
.feature-text.data-v-94171f33 {
	font-size: 14px;
	color: #666;
}
.purchase-actions.data-v-94171f33 {
	padding: 20px 15px;
	text-align: center;
}
.purchase-btn.data-v-94171f33 {
	width: 100%;

	left: 20px;
	padding: 4px 12px;
	background: #007AFF;
	border-radius: 10px;
}
.recommend-text.data-v-94171f33 {
	font-size: 12px;
	color: white;
}
.plan-header.data-v-94171f33 {
	text-align: center;
	margin-bottom: 20px;
}
.plan-name.data-v-94171f33 {
	font-size: 18px;
	font-weight: bold;
	color: #333;
	display: block;
	margin-bottom: 10px;
}
.plan-price.data-v-94171f33 {
	display: flex;
	align-items: baseline;

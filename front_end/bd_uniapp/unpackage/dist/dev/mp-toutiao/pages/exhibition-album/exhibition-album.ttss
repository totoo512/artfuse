
.exhibition-album-container.data-v-c1dac981 {
	background-color: #f5f5f5;
	min-height: 100vh;
}
.search-section.data-v-c1dac981 {
	padding: 10px 15px;
	background: white;
	border-bottom: 1px solid #f0f0f0;
}
.exhibition-sessions.data-v-c1dac981 {
	padding: 15px;
}
.session-card.data-v-c1dac981 {
	background: white;
	border-radius: 12px;
	padding: 15px;
	margin-bottom: 15px;
	box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}
.session-header.data-v-c1dac981 {
	display: flex;
	justify-content: space-between;
	align-items: flex-start;
	margin-bottom: 15px;
}
.session-info.data-v-c1dac981 {
	flex: 1;
}
.session-title.data-v-c1dac981 {
	font-size: 18px;
	font-weight: bold;
	color: #333;
	display: block;
	margin-bottom: 5px;
}
.session-date.data-v-c1dac981 {
	font-size: 14px;
	color: #666;
	display: block;
	margin-bottom: 3px;
}
.session-location.data-v-c1dac981 {
	font-size: 14px;
	color: #999;
	display: block;
}
.session-stats.data-v-c1dac981 {
	margin-left: 10px;
}
.photo-grid.data-v-c1dac981 {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 8px;
}
.photo-item.data-v-c1dac981 {
	position: relative;
	aspect-ratio: 1;
	border-radius: 8px;
	overflow: hidden;
}
.photo-thumbnail.data-v-c1dac981 {
	width: 100%;
	height: 100%;
}
.more-overlay.data-v-c1dac981 {
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	background: rgba(0, 0, 0, 0.6);
	display: flex;
	align-items: center;
	justify-content: center;
}
.more-text.data-v-c1dac981 {
	color: white;
	font-size: 16px;
	font-weight: bold;
}
.empty-state.data-v-c1dac981 {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	padding: 60px 20px;
	text-align: center;
}
.empty-text.data-v-c1dac981 {
	font-size: 18px;
	color: #666;
	margin: 15px 0 5px;
}
.empty-desc.data-v-c1dac981 {
	font-size: 14px;
	color: #999;
	margin-bottom: 30px;
}
.go-exhibition-btn.data-v-c1dac981 {
	padding: 12px 30px;
	background: #007AFF;
	color: white;
	border: none;
	border-radius: 25px;
	font-size: 16px;
}

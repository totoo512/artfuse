
/* TODO: AI看展解析页面样式 */
.exhibition-container.data-v-faae53d7 {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 会话列表视图样式 */
.session-list-view.data-v-faae53d7 {
  padding: 20rpx;
}
.page-header.data-v-faae53d7 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  margin-bottom: 30rpx;
}
.page-title.data-v-faae53d7 {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}
.create-btn.data-v-faae53d7 {
  display: flex;
  align-items: center;
  padding: 15rpx 25rpx;
  background-color: #007aff;
  color: white;
  border: none;
  border-radius: 25rpx;
  font-size: 26rpx;
}
.create-text.data-v-faae53d7 {
  margin-left: 8rpx;
}
.session-list.data-v-faae53d7 {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.session-item.data-v-faae53d7 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background-color: white;
  border-radius: 15rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}
.session-info.data-v-faae53d7 {
  flex: 1;
}
.session-title.data-v-faae53d7 {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}
.session-meta.data-v-faae53d7 {
  display: flex;
  gap: 20rpx;
  margin-bottom: 10rpx;
}
.session-time.data-v-faae53d7 {
  font-size: 24rpx;
  color: #999;
}
.session-count.data-v-faae53d7 {
  font-size: 24rpx;
  color: #007aff;
}
.session-desc.data-v-faae53d7 {
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
}
.session-actions.data-v-faae53d7 {
  display: flex;
  gap: 15rpx;
}
.action-btn.data-v-faae53d7 {
  width: 60rpx;
  height: 60rpx;
  border: none;
  border-radius: 50%;
  background-color: #f8f8f8;
  display: flex;
  align-items: center;
  justify-content: center;
}
.empty-state.data-v-faae53d7 {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}
.empty-text.data-v-faae53d7 {
  font-size: 28rpx;
  color: #999;
  margin-top: 20rpx;
}
.empty-desc.data-v-faae53d7 {
  font-size: 24rpx;
  color: #ccc;
  margin-top: 10rpx;
}

/* 创建会话视图样式 */
.create-session-view.data-v-faae53d7 {
  min-height: 100vh;
  background-color: white;
}
.nav-header.data-v-faae53d7 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  border-bottom: 1rpx solid #eee;
}
.nav-back-btn.data-v-faae53d7 {
  width: 60rpx;
  height: 60rpx;
  border: none;
  background: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-title.data-v-faae53d7 {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.nav-placeholder.data-v-faae53d7 {
  width: 60rpx;
}
.create-methods.data-v-faae53d7 {
  padding: 30rpx;
}
.method-title.data-v-faae53d7 {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}
.method-item.data-v-faae53d7 {
  margin-bottom: 40rpx;
  padding: 30rpx;
  background-color: #f8f8f8;
  border-radius: 15rpx;
}
.method-header.data-v-faae53d7 {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}
.method-name.data-v-faae53d7 {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-left: 15rpx;
}
.method-desc.data-v-faae53d7 {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 20rpx;
  line-height: 1.4;
}
.link-input-area.data-v-faae53d7 {
  display: flex;
  gap: 15rpx;
}
.link-input.data-v-faae53d7 {
  flex: 1;
  padding: 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 26rpx;
}
.import-btn.data-v-faae53d7 {
  padding: 20rpx 30rpx;
  background-color: #007aff;
  color: white;
  border: none;
  border-radius: 8rpx;
  font-size: 26rpx;
}
.import-btn.data-v-faae53d7:disabled {
  background-color: #ccc;
}
.upload-photos.data-v-faae53d7 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15rpx;
  margin-bottom: 20rpx;
}
.photo-item.data-v-faae53d7 {
  position: relative;
  aspect-ratio: 1;
  border-radius: 8rpx;
  overflow: hidden;
}
.photo-image.data-v-faae53d7 {
  width: 100%;
  height: 100%;
}
.photo-label.data-v-faae53d7 {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 8rpx;
  background: linear-gradient(transparent, rgba(0,0,0,0.7));
  color: white;
  font-size: 20rpx;
  text-align: center;
}
.photo-delete.data-v-faae53d7 {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 30rpx;
  height: 30rpx;
  background-color: rgba(0,0,0,0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.photo-buttons.data-v-faae53d7 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 15rpx;
  margin-bottom: 30rpx;
}
.photo-btn.data-v-faae53d7 {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 25rpx;
  border: 2rpx dashed #007aff;
  background-color: white;
  color: #007aff;
  border-radius: 8rpx;
  font-size: 24rpx;
}
.create-session-btn.data-v-faae53d7 {
  width: 100%;
  padding: 25rpx;
  background-color: #007aff;
  color: white;
  border: none;
  border-radius: 8rpx;
  font-size: 28rpx;
}
.create-session-btn.data-v-faae53d7:disabled {
  background-color: #ccc;
}

/* 会话详情视图样式 */
.session-detail-view.data-v-faae53d7 {
  min-height: 100vh;

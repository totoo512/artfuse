
.generated-works-container.data-v-c4c9a8e3 {
	background-color: #f5f5f5;
	min-height: 100vh;
}
.nav-actions.data-v-c4c9a8e3 {
	display: flex;
	align-items: center;
}
.filter-btn.data-v-c4c9a8e3 {
	width: 32px;
	height: 32px;
	border-radius: 16px;
	background: #f8f9fa;
	border: none;
	display: flex;
	align-items: center;
	justify-content: center;
}
.filter-tabs.data-v-c4c9a8e3 {
	background: white;
	border-bottom: 1px solid #f0f0f0;
}
.tabs-scroll.data-v-c4c9a8e3 {
	white-space: nowrap;
}
.tabs-container.data-v-c4c9a8e3 {
	display: flex;
	padding: 0 15px;
}
.tab-item.data-v-c4c9a8e3 {
	display: flex;
	align-items: center;
	gap: 5px;
	padding: 12px 16px;
	margin-right: 10px;
	border-radius: 20px;
	background: #f8f9fa;
	transition: all 0.3s;
}
.tab-item.active.data-v-c4c9a8e3 {
	background: #007AFF;
	color: white;
}
.tab-text.data-v-c4c9a8e3 {
	font-size: 14px;
	color: inherit;
}
.works-grid.data-v-c4c9a8e3 {
	padding: 15px;
	display: grid;
	grid-template-columns: repeat(2, 1fr);
	gap: 15px;
}
.work-item.data-v-c4c9a8e3 {
	background: white;
	border-radius: 12px;
	overflow: hidden;
	box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}
.work-media.data-v-c4c9a8e3 {
	position: relative;
	aspect-ratio: 1;
}
.work-image.data-v-c4c9a8e3,
.work-video.data-v-c4c9a8e3 {
	width: 100%;
	height: 100%;
}
.media-type-badge.data-v-c4c9a8e3 {
	position: absolute;
	top: 8px;
	left: 8px;
	width: 24px;
	height: 24px;
	border-radius: 12px;
	background: rgba(0, 0, 0, 0.6);
	display: flex;
	align-items: center;
	justify-content: center;
}
.video-duration.data-v-c4c9a8e3 {
	position: absolute;
	bottom: 8px;
	right: 8px;
	padding: 2px 6px;
	background: rgba(0, 0, 0, 0.7);
	border-radius: 4px;
}
.duration-text.data-v-c4c9a8e3 {
	color: white;
	font-size: 10px;
}
.work-info.data-v-c4c9a8e3 {
	padding: 12px;
}
.work-title.data-v-c4c9a8e3 {
	font-size: 14px;
	font-weight: 500;
	color: #333;
	display: block;
	margin-bottom: 6px;
	line-height: 1.3;
	display: -webkit-box;
	-webkit-line-clamp: 2;
	-webkit-box-orient: vertical;
	overflow: hidden;
}
.work-meta.data-v-c4c9a8e3 {
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 8px;
}
.work-style.data-v-c4c9a8e3 {
	font-size: 12px;
	color: #007AFF;
	background: #e3f2fd;
	padding: 2px 6px;
	border-radius: 10px;
}
.work-date.data-v-c4c9a8e3 {
	font-size: 12px;
	color: #999;
}
.work-stats.data-v-c4c9a8e3 {
	display: flex;
	gap: 12px;
}
.stat-item.data-v-c4c9a8e3 {
	display: flex;
	align-items: center;
	gap: 3px;
}
.stat-text.data-v-c4c9a8e3 {
	font-size: 11px;
	color: #666;
}
.empty-state.data-v-c4c9a8e3 {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	padding: 60px 20px;
	text-align: center;
}
.empty-text.data-v-c4c9a8e3 {
	font-size: 18px;
	color: #666;
	margin: 15px 0 5px;
}
.empty-desc.data-v-c4c9a8e3 {
	font-size: 14px;
	color: #999;
	margin-bottom: 30px;
}
.create-btn.data-v-c4c9a8e3 {
	padding: 12px 30px;
	background: #007AFF;
	color: white;
	border: none;
	border-radius: 25px;
	font-size: 16px;
}

/* 筛选弹窗样式 */
.filter-popup.data-v-c4c9a8e3 {
	background: white;
	border-radius: 20px 20px 0 0;
	padding: 20px;
	max-height: 60vh;
}
.popup-header.data-v-c4c9a8e3 {
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 20px;
	padding-bottom: 15px;
	border-bottom: 1px solid #f0f0f0;
}
.popup-title.data-v-c4c9a8e3 {
	font-size: 18px;
	font-weight: bold;
	color: #333;
}
.close-btn.data-v-c4c9a8e3 {
	width: 32px;
	height: 32px;
	border-radius: 16px;
	background: #f8f9fa;
	border: none;
	display: flex;
	align-items: center;
	justify-content: center;
}
.filter-section.data-v-c4c9a8e3 {
	margin-bottom: 25px;
}
.section-title.data-v-c4c9a8e3 {
	font-size: 16px;
	font-weight: 500;
	color: #333;
	margin-bottom: 12px;
	display: block;
}
.filter-options.data-v-c4c9a8e3 {
	display: flex;
	flex-wrap: wrap;
	gap: 10px;
}
.option-item.data-v-c4c9a8e3 {
	padding: 8px 16px;
	border: 1px solid #e0e0e0;
	border-radius: 20px;
	background: #f8f9fa;
	transition: all 0.3s;
}
.option-item.selected.data-v-c4c9a8e3 {
	background: #007AFF;
	border-color: #007AFF;
}
.option-text.data-v-c4c9a8e3 {
	font-size: 14px;
	color: #666;
}
.option-item.selected .option-text.data-v-c4c9a8e3 {
	color: white;
}
.popup-actions.data-v-c4c9a8e3 {
	display: flex;
	gap: 15px;
	padding-top: 20px;
	border-top: 1px solid #f0f0f0;
}
.reset-btn.data-v-c4c9a8e3,
.confirm-btn.data-v-c4c9a8e3 {
	flex: 1;
	padding: 12px;
	border-radius: 8px;
	font-size: 16px;
	border: none;
}
.reset-btn.data-v-c4c9a8e3 {
	background: #f8f9fa;
	color: #666;
}
.confirm-btn.data-v-c4c9a8e3 {
	background: #007AFF;
	color: white;
}
